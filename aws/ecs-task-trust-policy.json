{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {"Service": "ecs-tasks.amazonaws.com"},
      "Action": "sts:AssumeRole",
      "Condition": {
        "ArnLike": {
          "aws:SourceArn": "arn:aws:ecs:us-east-2:243396654546:*"
        },
        "StringEquals": {
          "aws:SourceAccount": "243396654546"
        }
      }
    }
  ]
}
